{
  "schemaVersion": 1,
  "projectName": "example",
  "connect": {
    "targetName": "example",
    "aliases": [
      "ops-example"
    ],
    "hosts": [],
    "services": [],
    "defaultChecks": [
      "ssh",
      "ports",
      "systemd"
    ]
  },
  "provision": {
    "osFamily": "ubuntu",
    "packageManager": "apt",
    "architecture": "x86_64",
    "timezone": "Asia/Shanghai",
    "networkMode": "auto",
    "dryRunDefault": true,
    "offlineBundleDir": "provision/offline",
    "modules": {}
  },
  "deploys": {},
  "detect": {
    "schemaVersion": 1,
    "name": "example-online-detection",
    "checks": {}
  },
  "logs": {
    "schemaVersion": 1,
    "targetName": "example",
    "service": "example",
    "mode": "readonly",
    "sources": [],
    "correlate": {},
    "output": {
      "redact": true,
      "maxLines": 200,
      "includeFixHints": true
    }
  },
  "query": {
    "schemaVersion": 1,
    "defaultMode": "readonly",
    "mysql": {
      "enabled": true,
      "connection": {
        "name": "dev",
        "host": "127.0.0.1",
        "port": 3306,
        "database": "",
        "credentials": {
          "type": "env",
          "usernameEnv": "OPS_MYSQL_USERNAME",
          "passwordEnv": "OPS_MYSQL_PASSWORD"
        }
      },
      "allowedPrefixes": ["SELECT", "SHOW", "EXPLAIN", "WITH"],
      "deniedPrefixes": ["INSERT", "UPDATE", "DELETE", "DROP", "ALTER", "CREATE"],
      "redactColumns": ["password", "token", "secret", "mobile", "email"],
      "limits": {
        "maxRows": 100,
        "timeoutSeconds": 10
      }
    }
  },
  "dbVerify": {
    "schemaVersion": 1,
    "targetName": "example-db",
    "mode": "readonly",
    "connection": {
      "type": "mysql",
      "host": "127.0.0.1",
      "port": 3306,
      "database": "",
      "credentials": {
        "type": "env",
        "usernameEnv": "OPS_MYSQL_USERNAME",
        "passwordEnv": "OPS_MYSQL_PASSWORD"
      }
    },
    "localCode": {
      "root": ".",
      "include": [],
      "exclude": []
    },
    "schemaChecks": [],
    "dataChecks": [],
    "safety": {
      "allowedPrefixes": [
        "SELECT",
        "SHOW",
        "EXPLAIN",
        "WITH"
      ],
      "deniedPrefixes": ["INSERT", "UPDATE", "DELETE", "DROP", "ALTER", "CREATE"],
      "limits": {
        "maxRows": 100,
        "timeoutSeconds": 10
      },
      "redactColumns": [
        "password",
        "token",
        "secret"
      ]
    }
  }
}
