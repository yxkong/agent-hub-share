# MySQL mysqld configuration template for ops-bootstrap.
# Render profile values before applying. Keep passwords and users in project-private files.

[mysqld]
user = mysql
pid-file = /var/run/mysqld/mysqld.pid
socket = /var/run/mysqld/mysqld.sock
port = {{mysql_port|3306}}
bind-address = {{mysql_bind|127.0.0.1}}
datadir = {{mysql_data_dir|/var/lib/mysql}}

character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default-time-zone = '+08:00'
sql_mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION

max_connections = {{mysql_max_connections|100}}
max_allowed_packet = {{mysql_max_allowed_packet|64M}}
table_open_cache = {{mysql_table_open_cache|512}}
thread_cache_size = {{mysql_thread_cache_size|32}}
tmp_table_size = {{mysql_tmp_table_size|64M}}
max_heap_table_size = {{mysql_tmp_table_size|64M}}

innodb_buffer_pool_size = {{mysql_innodb_buffer_pool_size|512M}}
innodb_log_file_size = {{mysql_innodb_log_file_size|256M}}
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1

slow_query_log = {{mysql_slow_query_log|ON}}
slow_query_log_file = /var/log/mysql/mysql-slow.log
long_query_time = {{mysql_long_query_time|1}}
log_error = /var/log/mysql/error.log

skip_name_resolve = ON
local_infile = OFF

# Enable binary logs only when backup/replication policy is defined in project scope.
# log_bin = /var/log/mysql/mysql-bin.log
# binlog_expire_logs_seconds = 604800
